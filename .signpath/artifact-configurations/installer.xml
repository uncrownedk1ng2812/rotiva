<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": paste into SignPath (Project → Artifact configurations).
     The GitHub artifact rotiva-windows-unsigned is a zip with one file, Rotiva-Setup-<version>.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Rotiva-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
