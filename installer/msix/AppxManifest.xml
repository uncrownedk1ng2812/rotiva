<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest paket MSIX untuk Microsoft Store (nama produk = nama yang direservasi di Partner Center, persis). installer\build-msix.ps1 mengganti $(...) dengan nilai
  dari Partner Center (Product identity) dan versi rilis.
  Daftar ekstensi harus sama dengan FormatCatalog (dicek oleh MsixManifestTests).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 desktop5 com rescap">

  <Identity Name="$(IdentityName)" Publisher="$(Publisher)" Version="$(Version)" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$(DisplayName)</DisplayName>
    <PublisherDisplayName>$(PublisherDisplayName)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Rotiva" Executable="Rotiva.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="$(DisplayName)"
        Description="Convert files from a wheel: drag a file, then press Shift."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- "Start with Windows" (TrayIcon.SetAutostart pakai TaskId ini). -->
        <desktop:Extension Category="windows.startupTask" Executable="Rotiva.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="RotivaStartup" Enabled="true" DisplayName="$(DisplayName)" />
        </desktop:Extension>

        <!-- Dipakai menu klik kanan (RotivaShell.dll) untuk menjalankan Rotiva dengan identitas paket. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="Rotiva.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="Rotiva.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>

        <!--
          Menu klik kanan "Convert with Rotiva" (membuka roda di kursor), di menu baru Windows 11 maupun
          menu klasik. Registry HKCU di paket MSIX divirtualisasi, jadi submenu per format versi installer
          (ShellMenu) tidak bisa dipakai; menu ini dari src\Rotiva.ShellExtension (IExplorerCommand).
          Jenis file sama dengan FormatCatalog + folder (dicek oleh MsixManifestTests).
        -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".png"><desktop5:Verb Id="RotivaConvert" Clsid="345C3645-D481-40C5-90AA-B30D798A46E1" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpg"><desktop5:Verb Id="RotivaConvert" Clsid="345C3645-D481-40C5-90AA-B30D798A46E1" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpeg"><desktop5:Verb Id="RotivaConvert" Clsid="345C3645-D481-40C5-90AA-B30D798A46E1" /></desktop5:ItemType>
