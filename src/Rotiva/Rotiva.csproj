<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versi Windows SDK diperlukan untuk OCR bawaan Windows (Windows.Media.Ocr). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Hanya untuk NotifyIcon (tray). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Rotiva</Product>
    <Authors>Denish Chairany</Authors>
    <Company>Denish Chairany</Company>
    <Copyright>Copyright (c) 2026 Denish Chairany. Licensed under GPL-3.0.</Copyright>
    <Description>Convert files from a wheel: drag a file, then press Shift.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hindari bentrok nama dengan WPF (Application, Point, Color, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
