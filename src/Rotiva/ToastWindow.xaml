<Window x:Class="Rotiva.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rotiva"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Panel" Margin="24" Padding="18,12,26,12" CornerRadius="4" Background="#F00B0B0D"
            BorderBrush="#FFFF8A1F" BorderThickness="4,0,0,0" Opacity="0" MinWidth="340">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelShift" />
        </Border.RenderTransform>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IconText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                           Foreground="#FFFF8A1F" VerticalAlignment="Center" Margin="0,0,14,0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="IconSpin" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <StackPanel>
                    <TextBlock x:Name="HeaderText" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" Foreground="#FFFF8A1F" />
                    <TextBlock x:Name="MessageText" FontFamily="Bahnschrift" FontSize="17" FontWeight="SemiBold" Foreground="White"
                               MaxWidth="560" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HintText" FontFamily="Bahnschrift" FontSize="12" Foreground="#99FFFFFF"
                               Margin="0,3,0,0" Text="Click to open folder" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <Border x:Name="ProgressTrack" Height="3" Margin="0,10,0,0" Background="#33FFFFFF" ClipToBounds="True">
                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#FFFF8A1F" Width="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressSlide" />
                    </Border.RenderTransform>
                </Border>
            </Border>
        </StackPanel>
    </Border>
</Window>
